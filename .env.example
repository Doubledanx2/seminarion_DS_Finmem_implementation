# Copy this file to ".env" and fill in your own API keys (do NOT commit the real .env).
# Reproducing metrics/figures from the saved checkpoints needs NO keys; the keys are
# only required to re-run the data pipeline and the train/test LLM calls.

OPENAI_API_KEY="sk-..."              # trading decisions (gpt-4.1-mini) + ada-002 embeddings + LC-Trader
GEMINI_API_KEY="AIza..."             # news/filing summarisation (Gemini 3.1 Flash-Lite)
ALPACA_KEY="..."                     # Alpaca historical news API (key id)
ALPACA_KEY_SECRET_KEY="..."          # Alpaca historical news API (secret)
SEC_KEY="..."                        # sec-api.io — 10-K/10-Q extraction
# HF_TOKEN=""                        # optional: Hugging Face token for model downloads
